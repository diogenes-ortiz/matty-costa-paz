---
import Base from '../../layouts/Base.astro';
import ProjectPage from '../../components/ProjectPage.astro';
import { T, ROUTES, PROJECTS, PRESS } from '../../data/site.js';
import { photo, altFor, projectSeo, factualIntro } from '../../lib/helpers.js';
import { getImage } from 'astro:assets';

export function getStaticPaths() {
  return PROJECTS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const lang = 'es';
const t = T[lang];
const r = ROUTES[lang];
const abs = (x) => new URL(x, Astro.site).href;
const rel = (x) => import.meta.env.BASE_URL.replace(/[/]?$/, '/') + x;
const seo = projectSeo(p, lang);
const og = await getImage({ src: photo(p.slug, p.cover), width: 1200, format: 'jpg', quality: 80 });
const images = await Promise.all(p.gallery.map(async ([f]) => ({
  '@type': 'ImageObject', contentUrl: abs((await getImage({ src: photo(p.slug, f), width: 1200, format: 'jpg' })).src),
  caption: altFor(p, f, lang), creditText: p.credit ?? 'Matty Costa Paz',
})));
const press = (p.press || []).map((id) => PRESS.find((x) => x.id === id)).filter((n) => n && n.url);
const extra = [{
  '@type': 'CreativeWork', '@id': abs(rel(r.projects + p.slug + '/')) + '#obra',
  name: p.name[lang], headline: seo.title,
  description: p.excerpt?.[lang] ?? factualIntro(p, lang),
  dateCreated: String(p.year), inLanguage: lang,
  genre: p.scope[lang], keywords: [p.scope[lang], lang === 'es' ? 'interiorismo' : 'interior design', p.place[lang]].join(', '),
  creator: { '@id': abs(rel('')) + '#matty' },
  locationCreated: { '@type': 'Place', name: p.place[lang] },
  image: images,
  ...(press.length ? { subjectOf: press.map((n) => ({ '@type': 'Article', headline: n.title, url: n.url, publisher: { '@type': 'Organization', name: n.media } })) } : {}),
}];
---
<Base lang={lang} page="projects" overHero
  title={seo.title} description={seo.description}
  altPath={`en/projects/${p.slug}/`}
  image={og.src} imageAlt={altFor(p, p.cover, lang, { full: true })}
  crumbs={[[t.nav.projects, r.projects], [p.name[lang], r.projects + p.slug + '/']]}
  extraSchema={extra}>
  <ProjectPage p={p} lang={lang} />
</Base>
