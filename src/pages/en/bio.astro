---
import Base from '../../layouts/Base.astro';
import C from '../../components/StudioPage.astro';
import { T, ROUTES } from '../../data/site.js';
const lang = 'en';
const t = T[lang];
const r = ROUTES[lang];
const abs = (p) => new URL(import.meta.env.BASE_URL.replace(/[/]?$/, '/') + p, Astro.site).href;

---
<Base lang={lang} page="studio" pageType="ProfilePage" crumbs={[[t.nav.studio, r.studio]]}><C lang={lang} /></Base>
