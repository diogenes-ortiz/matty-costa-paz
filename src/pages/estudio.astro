---
const to = new URL(import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'bio/', Astro.site).href;
---
<!doctype html><html><head><meta charset="utf-8"><meta http-equiv="refresh" content={`0; url=${to}`}><link rel="canonical" href={to}><meta name="robots" content="noindex"></head><body><a href={to}>Bio</a></body></html>
