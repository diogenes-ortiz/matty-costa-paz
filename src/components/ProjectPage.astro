---
// Página de proyecto: portada, ficha, texto, galería y proyecto siguiente a todo el ancho.
import { Image } from 'astro:assets';
import { T, ROUTES, PROJECTS, PRESS } from '../data/site.js';
import { u, photo } from '../lib/helpers.js';

const { p, lang = 'es' } = Astro.props;
const t = T[lang];
const r = ROUTES[lang];
const es = lang === 'es';
const i = PROJECTS.findIndex((x) => x.slug === p.slug);
const next = PROJECTS[(i + 1) % PROJECTS.length];
const alt = (proj, file) => { const g = proj.gallery.find((x) => x[0] === file); return g ? g[es ? 1 : 2] : proj.name[lang]; };
const press = (p.press || []).map((id) => PRESS.find((x) => x.id === id)).filter(Boolean);
const gallery = p.gallery.filter(([f]) => f !== p.cover);

const ficha = [
  [t.fLocation, p.place[lang]],
  [t.fYear, p.year ?? t.pending],
  [t.fScope, p.scope[lang]],
  p.area ? [t.fArea, p.area[lang]] : null,
  p.credit ? [t.fPhoto, p.credit] : null,
].filter(Boolean);
---
<section class="hero project-hero">
  <Image src={photo(p.slug, p.cover)} alt={alt(p, p.cover)} widths={[800, 1280, 1920]} sizes="100vw" format="webp" quality={80}
    loading="eager" fetchpriority="high" class="cover" />
  <div class="wrap slide-cap">
    <p class="label light">{p.place[lang]}{p.year ? ` · ${p.year}` : ''}</p>
    <h1 class="cap-title" style="margin-top:14px">{p.name[lang]}</h1>
  </div>
</section>

<section class:list={['wrap project-info', { 'no-body': !p.body }]}>
  <dl class="ficha" data-reveal>
    {ficha.map(([k, v]) => (<div><dt class="label">{k}</dt><dd>{v}</dd></div>))}
    {press.length > 0 && (
      <div><dt class="label">{t.fPress}</dt><dd>{press.map((n, j) => (<>{j > 0 && ', '}{n.url ? <a href={n.url} target="_blank" rel="noopener">{n.media}</a> : n.media}</>))}</dd></div>
    )}
  </dl>
  {p.body && (
    <div class="project-body" data-reveal>
      {p.body[lang].map((para, j) => <p class:list={{ lead: j === 0 }}>{para}</p>)}
    </div>
  )}
</section>

<section class="wrap gallery" aria-label={es ? 'Galería' : 'Gallery'}>
  {gallery.map(([file]) => {
    const img = photo(p.slug, file);
    const portrait = img.height > img.width;
    return (
      <figure class:list={['g-item', portrait ? 'is-portrait' : img.width >= 1100 ? 'is-wide' : 'is-landscape']} data-reveal>
        <Image src={img} alt={alt(p, file)} widths={[600, 1000, 1600]} sizes={portrait ? '(min-width: 1100px) 33vw, (min-width: 720px) 50vw, 100vw' : img.width >= 1100 ? '100vw' : '(min-width: 1100px) 66vw, 100vw'}
          format="webp" quality={78} loading="lazy" />
      </figure>
    );
  })}
</section>

<a class="next-project" href={u(`${r.projects}${next.slug}/`)}>
  <Image src={photo(next.slug, next.cover)} alt={alt(next, next.cover)} widths={[800, 1280, 1920]} sizes="100vw" format="webp" quality={75} loading="lazy" class="cover" />
  <span class="next-cap wrap">
    <span class="label light">{t.next}</span>
    <span class="cap-title">{next.name[lang]}</span>
    <span class="link-line light">{t.view}</span>
  </span>
</a>
<div class="wrap back-row"><a class="link-line" href={u(r.projects)}>{t.back}</a></div>
