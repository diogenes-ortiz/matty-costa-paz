---
import { Image } from 'astro:assets';
import { SITE, T, ROUTES, PROJECTS } from '../data/site.js';
import { u, photo, nth, altFor } from '../lib/helpers.js';
import ProjectCard from './ProjectCard.astro';
import PressLogos from './PressLogos.astro';

const { lang = 'es' } = Astro.props;
const t = T[lang];
const r = ROUTES[lang];
const es = lang === 'es';
const P = Object.fromEntries(PROJECTS.map((p) => [p.slug, p]));
const href = (slug) => u(`${r.projects}${slug}/`);
const alt = (p, file, full = false) => altFor(p, file, lang, { full });

// Portada: una foto amplia por obra
const slides = ['costa-esmeralda-2024', 'piso-barrio-salamanca', 'costa-esmeralda-2025', 'beach-house-jose-ignacio', 'palacio-de-los-patos']
  .map((s) => [P[s], P[s].cover]);
// Fila 1: lo más reciente. Fila 2: más obras.
const latest = ['costa-esmeralda-2025', 'costa-esmeralda-2024', 'retiro'].map((s) => P[s]);
const more = ['adrogue-chico', 'botanico', 'beach-house-jose-ignacio'].map((s) => P[s]);
const madrid = P['piso-barrio-salamanca'];
const capText = (p) => p.excerpt?.[lang] ?? [p.place[lang], p.year].filter(Boolean).join(' · ');
---
<section class="hero" aria-roledescription="carousel" aria-label={es ? 'Obras destacadas' : 'Featured work'} data-hero>
  {slides.map(([p, file], i) => (
    <figure class:list={['slide', { 'is-active': i === 0 }]} data-slide aria-hidden={i === 0 ? undefined : 'true'}>
      <Image src={photo(p.slug, file)} alt={alt(p, file, true)} widths={[800, 1280, 1920]} sizes="100vw" format="webp" quality={80}
        loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} class="cover" />
      <figcaption class="wrap slide-cap">
        <a href={href(p.slug)}>
          <p class="cap-title">{p.name[lang]}</p>
          <p class="cap-text">{capText(p)}</p>
        </a>
      </figcaption>
    </figure>
  ))}
  <div class="wrap hero-count" aria-hidden="true">
    {slides.map((_, i) => <button type="button" data-goto={i} class:list={{ 'is-active': i === 0 }}>{String(i + 1).padStart(2, '0')}</button>)}
  </div>
</section>

<section class="statement wrap">
  <h1 class="label center" data-reveal>Matty Costa Paz · {es ? 'Interiorista en Buenos Aires' : 'Interior designer in Buenos Aires'}</h1>
  <p class="statement-title" data-reveal>{t.statement}</p>
  <p class="intro" data-reveal>{t.intro}</p>
  <ul class="cities label" data-reveal>{SITE.cities.map((c) => <li>{c}</li>)}</ul>
</section>

<section class="band" aria-labelledby="latest">
  <span class="vword vword-l" aria-hidden="true">{t.vertical}</span>
  <span class="vword vword-r" aria-hidden="true">{t.vertical}</span>
  <div class="wrap">
    <h2 class="band-title" id="latest">{t.latest}</h2>
    <ul class="row">{latest.map((p) => <ProjectCard p={p} lang={lang} />)}</ul>
  </div>
</section>

<section class="feature" aria-labelledby="feat">
  <Image src={photo(madrid.slug, nth(madrid, 5))} alt={alt(madrid, nth(madrid, 5))}
    widths={[800, 1280, 1920]} sizes="100vw" format="webp" quality={78} loading="lazy" class="cover" />
  <div class="feature-cap wrap">
    <p class="label light">{t.featured} · {madrid.place[lang]}</p>
    <h2 id="feat" class="cap-title">{madrid.name[lang]}</h2>
    <p class="cap-text">{es
      ? 'Separé la sala íntima con un cerramiento de aluminio bronce y vidrio, sin cortar la continuidad visual: la idea fue no generar divisiones, sino conexiones.'
      : 'I set the intimate sitting room apart with a bronze aluminium and glass partition, without breaking the visual flow: the idea was to create connections, not divisions.'}</p>
    <a class="link-line light" href={href(madrid.slug)}>{t.view}</a>
  </div>
</section>

<section class="band" aria-labelledby="more">
  <span class="vword vword-l" aria-hidden="true">{t.verticalMore}</span>
  <span class="vword vword-r" aria-hidden="true">{t.verticalMore}</span>
  <div class="wrap">
    <h2 class="band-title" id="more">{t.more}</h2>
    <ul class="row">{more.map((p) => <ProjectCard p={p} lang={lang} />)}</ul>
    <div class="band-foot"><a class="link-line" href={u(r.projects)}>{t.allProjects}</a></div>
  </div>
</section>

<section class="band studio-band" aria-labelledby="bio">
  <span class="vword vword-l" aria-hidden="true">{t.verticalStudio}</span>
  <span class="vword vword-r" aria-hidden="true">{t.verticalStudio}</span>
  <div class="wrap">
    <h2 class="band-title" id="bio">{t.studioLabel}</h2>
    <div class="studio-grid">
      <div class="studio-media" data-reveal>
        <Image src={photo('palacio-de-los-patos', nth(P['palacio-de-los-patos'], 1))} alt={alt(P['palacio-de-los-patos'], nth(P['palacio-de-los-patos'], 1))}
          widths={[400, 600]} sizes="(min-width: 960px) 40vw, 100vw" format="webp" quality={80} loading="lazy" />
      </div>
      <div data-reveal>
        <p class="studio-text">{t.studioText}</p>
        <ul class="memberships">{t.memberships.map((m) => <li>{m}</li>)}</ul>
        <a class="link-line" href={u(r.studio)}>{t.studioLink}</a>
      </div>
    </div>
  </div>
</section>

<section class="band press" aria-labelledby="pre">
  <div class="wrap">
    <h2 class="band-title" id="pre">{t.pressTitle}</h2>
    <PressLogos />
    <div class="band-foot"><a class="link-line" href={u(r.press)}>{t.pressLink}</a></div>
  </div>
</section>

<section class="contact wrap" aria-labelledby="con">
  <p class="label center" id="con">{t.contactLabel}</p>
  <h2 data-reveal>{t.contactTitle}</h2>
  <div class="contact-links">
    <a class="link-line" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <a class="link-line" href={SITE.instagram} target="_blank" rel="noopener">Instagram</a>
    <a class="link-line" href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
  </div>
</section>

<script>
  const hero = document.querySelector('[data-hero]');
  if (hero) {
    const slides = [...hero.querySelectorAll('[data-slide]')];
    const dots = [...hero.querySelectorAll('[data-goto]')];
    let i = 0, timer;
    const go = (n) => {
      slides[i].classList.remove('is-active'); slides[i].setAttribute('aria-hidden', 'true'); dots[i].classList.remove('is-active');
      i = (n + slides.length) % slides.length;
      slides[i].classList.add('is-active'); slides[i].removeAttribute('aria-hidden'); dots[i].classList.add('is-active');
    };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const start = () => { if (!reduce) { clearInterval(timer); timer = setInterval(() => go(i + 1), 6500); } };
    dots.forEach((d) => d.addEventListener('click', () => { go(+d.dataset.goto); start(); }));
    document.addEventListener('visibilitychange', () => (document.hidden ? clearInterval(timer) : start()));
    start();
  }
</script>
