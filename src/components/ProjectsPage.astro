---
// Todas las obras en una sola grilla, sin categorías (pedido de Matty: no encasillarse).
import { T, PROJECTS } from '../data/site.js';
import ProjectCard from './ProjectCard.astro';
const { lang = 'es' } = Astro.props;
const t = T[lang];
---
<section class="page-head wrap">
  <h1 class="band-title">{t.projectsTitle}</h1>
  <p class="page-intro">{t.projectsIntro}</p>
</section>

<section class="wrap projects-grid-wrap" aria-labelledby="obras-t">
  <h2 id="obras-t" class="sr-only">{lang === 'es' ? 'Obras realizadas de diseño de interiores' : 'Completed interior design work'}</h2>
  <ul class="projects-grid">
    {PROJECTS.map((p) => <ProjectCard p={p} lang={lang} excerpt={false} />)}
  </ul>
</section>
