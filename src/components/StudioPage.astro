---
// Bio: texto oficial de Matty (Bio.pdf), tal cual lo escribió, en tercera persona.
// Solo se limpiaron los cortes de línea del PDF y dos tildes (década, formó).
import { Image } from 'astro:assets';
import { T, ROUTES, PROJECTS } from '../data/site.js';
import { u, photo, altFor } from '../lib/helpers.js';
const pdp = PROJECTS.find((p) => p.slug === 'palacio-de-los-patos');
const { lang = 'es' } = Astro.props;
const t = T[lang];
const es = lang === 'es';

const lead = es
  ? 'Matty Costa Paz es interiorista especializada en arquitectura de interiores, creando espacios para la emoción que genera la belleza, para compartir momentos y vivir una vida bien vivida hace más de treinta años.'
  : 'Matty Costa Paz is an interior designer specialising in interior architecture, creating spaces for the emotion that beauty brings, for sharing moments and living a life well lived, for over thirty years.';

const story = es ? [
  'Su lenguaje arquitectónico es sofisticado, atemporal y refinado concebido a medida de cada cliente, comprendiendo sus sueños, aspiraciones y deseos.',
  'Como diseñadora da gran importancia a la armonía entre sus interiores y su entorno y la sustentabilidad de cada proyecto.',
  'Basada en Buenos Aires y con proyectos globales, multipremiada, sus trabajos han sido publicados en AD Italia, Casa Vogue, Architectural Digest, ElleDecor entre otras publicaciones internacionales.',
  'Viajera constante año tras año busca inspiración en diferentes lugares del mundo, experiencias que se plasma en sus proyectos.',
  'Es miembro de Design Leadership Network.',
  'Socia Honoraria de DINA (Diseñadores Nacionales Asociados) y durante casi una década formó parte de la comisión directiva de DArA donde puso su sello en el congreso internacional DArA ID en cuatro ediciones.',
] : [
  'Her architectural language is sophisticated, timeless and refined, conceived for each client, understanding their dreams, aspirations and desires.',
  'As a designer she places great importance on the harmony between her interiors and their surroundings, and on the sustainability of every project.',
  'Based in Buenos Aires with projects around the world, and recipient of multiple awards, her work has been published in AD Italia, Casa Vogue, Architectural Digest and Elle Decor, among other international publications.',
  'A constant traveller, year after year she seeks inspiration in different places around the world, experiences that find their way into her projects.',
  'She is a member of the Design Leadership Network.',
  'Honorary member of DINA (Diseñadores Nacionales Asociados), she served for nearly a decade on the executive board of DArA, where she left her mark on four editions of the international DArA ID congress.',
];
---
<section class="page-head wrap">
  <h1 class="band-title">{t.studioTitle}</h1>
  <p class="page-lead">{lead}</p>
</section>

<section class="wrap studio-page">
  <div class="studio-media" data-reveal>
    <!-- [COMPLETAR] retrato de Matty; por ahora, una obra -->
    <Image src={photo(pdp.slug, pdp.cover)} alt={altFor(pdp, pdp.cover, lang, { full: true })}
      widths={[600, 1000]} sizes="(min-width: 960px) 40vw, 100vw" format="webp" quality={80} loading="eager" />
  </div>
  <div class="studio-copy" data-reveal>
    {story.map((s) => <p>{s}</p>)}
  </div>
</section>

<section class="contact wrap">
  <h2 data-reveal>{t.contactTitle}</h2>
  <div class="contact-links"><a class="link-line" href={u(ROUTES[lang].contact)}>{t.nav.contact}</a></div>
</section>
