---
// Bio: texto oficial de Matty (Bio.pdf, 18/11/2026), pasado a primera persona.
import { Image } from 'astro:assets';
import { T, ROUTES } from '../data/site.js';
import { u, photo } from '../lib/helpers.js';
const { lang = 'es' } = Astro.props;
const t = T[lang];
const es = lang === 'es';

const lead = es
  ? 'Soy interiorista especializada en arquitectura de interiores. Hace más de treinta años que creo espacios para la emoción que genera la belleza, para compartir momentos y vivir una vida bien vivida.'
  : 'I am an interior designer specialising in interior architecture. For over thirty years I have been creating spaces for the emotion that beauty brings, for sharing moments and living a life well lived.';

const story = es ? [
  'Mi lenguaje arquitectónico es sofisticado, atemporal y refinado, concebido a medida de cada cliente: comprendiendo sus sueños, aspiraciones y deseos.',
  'Doy gran importancia a la armonía entre mis interiores y su entorno, y a la sustentabilidad de cada proyecto.',
  'Estoy basada en Buenos Aires y tengo proyectos en distintos lugares del mundo. Mis trabajos fueron premiados y publicados en AD Italia, Casa Vogue, Architectural Digest y Elle Decor, entre otras publicaciones internacionales.',
  'Viajo constantemente: año tras año busco inspiración en distintos lugares del mundo, experiencias que se plasman en mis proyectos.',
] : [
  'My architectural language is sophisticated, timeless and refined, conceived for each client: understanding their dreams, aspirations and desires.',
  'I place great importance on the harmony between my interiors and their surroundings, and on the sustainability of every project.',
  'I am based in Buenos Aires and work on projects around the world. My work has received awards and has been published in AD Italia, Casa Vogue, Architectural Digest and Elle Decor, among other international publications.',
  'I travel constantly: year after year I look for inspiration in different places around the world, experiences that find their way into my projects.',
];

const path = es ? [
  ['Design Leadership Network', 'Miembro.'],
  ['DINA, Diseñadores Nacionales Asociados', 'Socia honoraria.'],
  ['DArA, Diseñadores Argentinos Asociados', 'Durante casi una década formé parte de la comisión directiva y puse mi sello en cuatro ediciones del congreso internacional DArA ID.'],
] : [
  ['Design Leadership Network', 'Member.'],
  ['DINA, Diseñadores Nacionales Asociados', 'Honorary member.'],
  ['DArA, Diseñadores Argentinos Asociados', 'For nearly a decade I served on the executive board and left my mark on four editions of the international DArA ID congress.'],
];

const publications = ['AD Italia', 'Architectural Digest', 'Casa Vogue', 'Elle Decor'];
---
<section class="page-head wrap">
  <h1 class="band-title">{t.studioTitle}</h1>
  <p class="page-lead">{lead}</p>
</section>

<section class="wrap studio-page">
  <div class="studio-media" data-reveal>
    <!-- [COMPLETAR] retrato de Matty; por ahora, una obra -->
    <Image src={photo('palacio-de-los-patos', '01.jpg')} alt={es ? 'Living blanco con ventanas en arco y grandes obras de arte, Palacio de los Patos' : 'White living room with arched windows and large artworks, Palacio de los Patos'}
      widths={[600, 1000]} sizes="(min-width: 960px) 40vw, 100vw" format="webp" quality={80} loading="eager" />
  </div>
  <div class="studio-copy" data-reveal>
    {story.map((s) => <p>{s}</p>)}
    <ul class="cities label" style="justify-content:flex-start;margin-top:32px">{publications.map((m) => <li>{m}</li>)}</ul>
  </div>
</section>

<section class="band press" aria-labelledby="tra">
  <div class="wrap">
    <h2 class="band-title" id="tra">{es ? 'Trayectoria' : 'Background'}</h2>
    <dl class="path">
      {path.map(([k, v]) => (<div data-reveal><dt class="card-title">{k}</dt><dd class="card-text">{v}</dd></div>))}
    </dl>
  </div>
</section>

<section class="contact wrap">
  <h2 data-reveal>{t.contactTitle}</h2>
  <div class="contact-links"><a class="link-line" href={u(ROUTES[lang].contact)}>{t.nav.contact}</a></div>
</section>
