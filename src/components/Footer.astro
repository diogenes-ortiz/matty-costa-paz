---
import { SITE, T, ROUTES, NAV } from '../data/site.js';
const { lang = 'es' } = Astro.props;
const t = T[lang];
const r = ROUTES[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const u = (p) => base + p;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="wordmark">Matty Costa Paz</p>
      <p class="muted">{t.role}<br />{SITE.cities.join(' · ')}</p>
    </div>
    <ul class="footer-links">
      {NAV.map((k) => (
        <li><a href={u(r[k])}>{t.nav[k]}</a></li>
      ))}
    </ul>
    <ul class="footer-links">
      <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      <li><a href={SITE.instagram} target="_blank" rel="noopener">Instagram</a></li>
      <li><a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
    </ul>
  </div>
  <div class="wrap footer-base muted">
    <span>© {year} Matty Costa Paz. {t.rights}</span>
  </div>
</footer>
